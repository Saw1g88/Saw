#!name = GitHub Private Access
#!desc = GitHub 访问私有仓库
#!author = Peng-YM (modified)
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/GitHub.png

[Argument]
username = input,"",tag=GitHub用户名,desc=你的GitHub用户名，用于判断是否为你自己的私库
token = input,"",tag=Token,desc=GitHub Personal Access Token（Settings->Developer settings->Personal access tokens，勾选repo权限）

[Script]
http-request ^https?:\/\/(raw|gist)\.githubusercontent\.com requires-body=false, script-path=https://你的脚本托管地址/github-private-repo.js, tag=Github Private, argument=[{username},{token}]

[MITM]
hostname = raw.githubusercontent.com, gist.githubusercontent.com
