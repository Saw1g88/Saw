#!name = GitHub
#!desc = 拉取私库内容
#!icon = https://raw.githubusercontent.com/Saw1g88/Saw/main/Icon/128px/github.png

[Argument]
username = input,"",tag=GitHub 用户名,desc=GitHub 用户名
token = input,"",tag=Token,desc=GitHub Personal Access Token（Settings->Developer settings->Personal access tokens，勾选repo权限）

[Script]
http-request ^https?:\/\/(raw|gist)\.githubusercontent\.com requires-body=false, script-path=https://raw.githubusercontent.com/Saw1g88/Saw/refs/heads/main/Module/Script/GitHub/github.js, tag=Github Private, argument=[{username},{token}]

[MITM]
hostname = raw.githubusercontent.com, gist.githubusercontent.com
