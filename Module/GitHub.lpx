#!name = Github
#!desc = 拉取私库内容
#!icon = https://raw.githubusercontent.com/Saw1g88/Saw/main/Icon/128px/github.png

[Argument]
token = input,"",tag=令牌,desc=GitHub Personal Access Token

[Rewrite]
request if ${url} ~= /^https?:\/\/(?:raw|gist)\.githubusercontent\.com/ then request.header.del("Authorization") | request.header.set("Authorization", "token ${token}")
request if ${url} ~= /^https?:\/\/(?:raw|gist)\.githubusercontent\.com/ then request.header.set("Accept-Language", "en-us")

[Mitm]
hostname = %APPEND% raw\.githubusercontent\.com, gist\.githubusercontent\.com
