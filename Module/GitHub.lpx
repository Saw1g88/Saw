#!name=GitHub
#!desc=拉取私库内容
#!icon=https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1048.png

[Argument]
用户名=input,"",tag=用户名,desc=GitHub 用户名
令牌=input,"",tag=令牌,desc=GitHub Personal Access Token

[Rewrite]
^https?:\/\/(raw|gist)\.githubusercontent\.com\/{用户名} header-del Authorization
^https?:\/\/(raw|gist)\.githubusercontent\.com\/{用户名} header-add Authorization token {令牌}
^https?:\/\/(raw|gist)\.githubusercontent\.com header-replace Accept-Language en-us

[MITM]
hostname = raw.githubusercontent.com, gist.githubusercontent.com
