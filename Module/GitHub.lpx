#!name=GitHub Private Access
#!desc=GitHub 访问私有仓库
#!author=Peng-YM
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/GitHub.png
#!homepage=https://t.me/cool_scripts/147

[Argument]
username = input,"",tag=用户名,desc=GitHub 用户名
token = input,"",tag=令牌,desc=GitHub Personal Access Token

[Rewrite]
request if ${url} ~= /^https:\/\/(?:raw|gist)\.githubusercontent\.com\/([^\/]+)\// as github_user && ${github_user.1} == ${username} then request.header.set("Authorization", "token ${token}")
request if ${url} ~= /^https:\/\/(?:raw|gist)\.githubusercontent\.com\// then request.header.set("Accept-Language", "en-us")

[Mitm]
hostname = raw.githubusercontent.com, gist.githubusercontent.com
